[Unit]
Description=SaaiOS Platform Runtime
Documentation=https://github.com/Damasker/saaios
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=saaios
Group=saaios
WorkingDirectory=/var/lib/saaios
ExecStart=/usr/local/bin/saaios-runtime --config /etc/saaios/saaios.toml
Restart=on-failure
RestartSec=2
RuntimeDirectory=saaios
RuntimeDirectoryMode=0755
StateDirectory=saaios
Environment=RUST_LOG=info
# Keep AI side effects conservative on appliance hosts (override provider in toml).
Environment=SAAIOS_MOCK=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/saaios /run/saaios
ReadOnlyPaths=/etc/saaios

[Install]
WantedBy=multi-user.target
