sui 1

screen root {
  column {
    content id=content fill {
      action selected-entity page=now top=720 height=210 label="Объект пространства" action=inspect_selected_entity
      action new-intent page=now top=950 height=140 label="Новое намерение" action=open_intent_input
      action space-home page=spaces top=430 height=190 label="Дом" action=select_space:home
      action space-work page=spaces top=650 height=190 label="Работа" action=select_space:work
      action space-personal page=spaces top=870 height=190 label="Личное" action=select_space:personal
      action space-saaios page=spaces top=1090 height=190 label="SaaiOS" action=select_space:saaios
    }
    tabs id=root-tabs height=300 {
      tab now label="Сейчас" icon=now action=select_root:now
      tab inbox label="Входящие" icon=inbox action=select_root:inbox
      tab spaces label="Пространства" icon=spaces action=select_root:spaces
      tab me label="Я" icon=person action=select_root:me
    }
  }
}
