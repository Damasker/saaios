#!/bin/busybox ash
# Back to RNDIS gadget. Boot already does this; use after a failed usb-host
# or if a shell still exists. Power 2s reboot is the reliable return.
BB=/bin/busybox
DWC3=/sys/devices/platform/13600000.usb/13600000.dwc3

rm -f /tmp/usb-role-host

if [ -w /sys/class/typec/port0/data_role ]; then
  echo device > /sys/class/typec/port0/data_role
fi
if [ -w "$DWC3/id" ]; then
  echo 1 > "$DWC3/id"
fi
if [ -w "$DWC3/b_sess" ]; then
  echo 1 > "$DWC3/b_sess"
fi
if [ -w /sys/class/host_notify/usb_otg/mode ]; then
  echo PERIPHER > /sys/class/host_notify/usb_otg/mode
fi

if [ -e /sys/class/udc/13600000.dwc3 ] && [ -e /config/usb_gadget/g1/UDC ]; then
  echo 13600000.dwc3 > /config/usb_gadget/g1/UDC
fi

for n in rndis0 usb0 usb1; do
  if [ -e "/sys/class/net/$n" ]; then
    $BB ifconfig "$n" 192.168.42.1 netmask 255.255.255.0 up
    echo "usb-device: $n 192.168.42.1 telnet :23"
    exit 0
  fi
done
echo "usb-device: role device; waiting for rndis0 (init retry_gadget will bind)"
exit 0
