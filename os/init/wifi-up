#!/bin/busybox ash
# Bring up onboard SCSC Maxwell wlan0. Never called from init/rcS.
# Firmware lives in /vendor/etc/wifi (also /etc/wifi and /system/etc/wifi).
# Does not switch USB host.
BB=/bin/busybox

if [ ! -e /sys/class/net/wlan0 ]; then
  echo "wifi-up: no wlan0"
  exit 1
fi

echo "wifi-up: ifconfig wlan0 up"
$BB ifconfig wlan0 up
echo "operstate=$(cat /sys/class/net/wlan0/operstate 2>/dev/null)"
echo "address=$(cat /sys/class/net/wlan0/address 2>/dev/null)"
echo "=== dmesg tail ==="
$BB dmesg | $BB tail -50
exit 0
