From: SaaiOS <os@saaios>
Subject: synaptics td4150: pre-clear ATTN before ENABLE_REPORT; skip 0x25

v018 probe ok but touch deaf: 0x05 timed out (STATUS_OK unread), then 0x25
timed out (+1s). IRQ 244 stuck; event3 empty.

v019:
1. syna_tcm_attn_clear_pending(): full read_message while ATTN GPIO active
   (log before/after). Call after enable_irq before touch_init, before 0x05,
   and in resume retry path.
2. syna_tcm_enable_touch_report(): scan-start before 0x05; poll read_message
   on timeout instead of a single salvage read.
3. USE_DEFAULT_TOUCH_REPORT_CONFIG: install default report layout without
   sending GET_TOUCH_REPORT_CONFIG (0x25).
4. touch_set_input_reporting: default config first, then ENABLE_REPORT.

Applies after syna-tcm-enable-report-salvage.patch.

--- a/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.c
+++ b/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.c
@@ -128,6 +128,46 @@ int syna_tcm_spi_resync(struct syna_tcm_hcd *tcm_hcd)
 	mutex_unlock(&tcm_hcd->rw_ctrl_mutex);
 	return 0;
 }
+
+static bool syna_tcm_attn_active(struct syna_tcm_hcd *tcm_hcd)
+{
+	const struct syna_tcm_board_data *bdata;
+
+	if (!tcm_hcd || !tcm_hcd->hw_if || !tcm_hcd->hw_if->bdata)
+		return false;
+
+	bdata = tcm_hcd->hw_if->bdata;
+	if (bdata->irq_gpio < 0)
+		return false;
+
+	return gpio_get_value(bdata->irq_gpio) == bdata->irq_on_state;
+}
+
+static int syna_tcm_attn_clear_pending(struct syna_tcm_hcd *tcm_hcd)
+{
+	int i, n = 0;
+	unsigned char code;
+
+	if (!tcm_hcd || !tcm_hcd->read_message)
+		return 0;
+
+	input_info(true, tcm_hcd->pdev->dev.parent,
+		"ATTN before clear: %d\n", syna_tcm_attn_active(tcm_hcd) ? 1 : 0);
+
+	for (i = 0; i < 8 && syna_tcm_attn_active(tcm_hcd); i++) {
+		if (tcm_hcd->read_message(tcm_hcd, NULL, 0) < 0)
+			break;
+		code = tcm_hcd->status_report_code;
+		n++;
+		input_info(true, tcm_hcd->pdev->dev.parent,
+			"ATTN clear read %d code 0x%02x\n", n, code);
+	}
+
+	input_info(true, tcm_hcd->pdev->dev.parent,
+		"ATTN after clear: %d (%d reads)\n",
+		syna_tcm_attn_active(tcm_hcd) ? 1 : 0, n);
+
+	return n;
+}
 int syna_tcm_add_module(struct syna_tcm_module_cb *mod_cb, bool insert)
 {
 	struct syna_tcm_module_handler *mod_handler;
@@ -2175,6 +2215,7 @@ int syna_tcm_enable_touch_report(struct syna_tcm_hcd *tcm_hcd)
 {
 	int retval;
+	int i;
 	unsigned char report_id = REPORT_TOUCH;
 	unsigned char *resp_buf;
 	unsigned int resp_buf_size;
@@ -2186,6 +2227,9 @@ int syna_tcm_enable_touch_report(struct syna_tcm_hcd *tcm_hcd)
 	resp_buf = NULL;
 	resp_buf_size = 0;
 
+	syna_tcm_attn_clear_pending(tcm_hcd);
+	syna_tcm_set_scan_start_stop_cmd(tcm_hcd, 1);
+
 	retval = tcm_hcd->write_message(tcm_hcd, CMD_ENABLE_REPORT,
 			&report_id, 1, &resp_buf, &resp_buf_size,
 			&resp_length, NULL, 0);
@@ -2196,7 +2240,22 @@ int syna_tcm_enable_touch_report(struct syna_tcm_hcd *tcm_hcd)
 		 */
 		kfree(resp_buf);
 		resp_buf = NULL;
-		if (tcm_hcd->read_message(tcm_hcd, NULL, 0) == 0 &&
+		for (i = 0; i < 20; i++) {
+			if (tcm_hcd->read_message(tcm_hcd, NULL, 0) == 0 &&
+					tcm_hcd->status_report_code == STATUS_OK) {
+				input_info(true, tcm_hcd->pdev->dev.parent,
+					"enabled REPORT_TOUCH (salvaged)\n");
+				tcm_hcd->report_touch_cmd_sent = true;
+				return 0;
+			}
+			if (syna_tcm_attn_active(tcm_hcd))
+				continue;
+			msleep(10);
+		}
+		syna_tcm_attn_clear_pending(tcm_hcd);
+		if (tcm_hcd->read_message(tcm_hcd, NULL, 0) == 0 &&
 				tcm_hcd->status_report_code == STATUS_OK) {
 			input_info(true, tcm_hcd->pdev->dev.parent,
 				"enabled REPORT_TOUCH (salvaged)\n");
@@ -2873,8 +2932,11 @@ mod_resume:
 		input_info(true, tcm_hcd->pdev->dev.parent, "enable edge reject\n");
 #endif
 
-	if (!tcm_hcd->report_touch_cmd_sent)
+	if (!tcm_hcd->report_touch_cmd_sent) {
+		syna_tcm_attn_clear_pending(tcm_hcd);
 		syna_tcm_enable_touch_report(tcm_hcd);
-	else
+	} else {
 		input_info(true, tcm_hcd->pdev->dev.parent,
 			"REPORT_TOUCH already requested, skip ENABLE_REPORT\n");
+	}
 
 	if (tcm_hcd->wakeup_gesture_enabled || tcm_hcd->ear_detect_enable)
@@ -3472,6 +3534,8 @@ static int syna_tcm_probe(struct platform_device *pdev)
 
 	atomic_set(&tcm_hcd->host_downloading, 0);
 
+	syna_tcm_attn_clear_pending(tcm_hcd);
+
 	/* initialize the touch reporting */
 	retval = touch_init(tcm_hcd);
 	if (retval < 0) {
