From: SaaiOS <os@saaios>
Subject: synaptics td4150: clear in_hdl_mode on on-chip 0x02, identify+touch_reinit

Stock never sends CMD_ENABLE_REPORT 0x05. After HDL it runs
HELP_SEND_REINIT_NOTIFICATION (identify + touch_reinit). This unit
boots RomBoot 0x04, 0x45 fails, on-chip mode 0x02 — skip HDL is
correct, but sensor_detection left in_hdl_mode=true so resume took
wait_hdl + goto mod_resume and skipped touch_reinit.

0x1b plen=2 is REPORT_STATUS leftover holding level-ATTN. Drain it
fully (max 8, no polling, stop repeating plen>512) before identify
and touch_reinit. Do not treat it as an ENABLE_REPORT ack.

Keep skip-second-identify, no IRQ unwind on app-info timeout in FW
mode, no do_polling, do not zero identify plen.

Applies after syna-tcm-enable-report-oneshot-drain.patch.

--- a/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.c
+++ b/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.c
@@ -150,6 +150,136 @@ static bool syna_tcm_attn_active(struct syna_tcm_hcd *tcm_hcd)
 
 	return gpio_get_value(bdata->irq_gpio) == bdata->irq_on_state;
 }
+
+static int syna_tcm_attn_gpio_value(struct syna_tcm_hcd *tcm_hcd)
+{
+	const struct syna_tcm_board_data *bdata;
+
+	if (!tcm_hcd || !tcm_hcd->hw_if || !tcm_hcd->hw_if->bdata)
+		return -1;
+
+	bdata = tcm_hcd->hw_if->bdata;
+	if (bdata->irq_gpio < 0)
+		return -1;
+
+	return gpio_get_value(bdata->irq_gpio);
+}
+
+/* Drain leftover REPORT_STATUS (0x1b) / continued_read frames that hold
+ * level-ATTN. Full read_message (not marker-only). Max 8. Never start
+ * polling. Stop if the same plen>512 dump repeats.
+ */
+static int syna_tcm_drain_unread_reports(struct syna_tcm_hcd *tcm_hcd)
+{
+	int i, n = 0;
+	unsigned int last_large = 0;
+	int stuck = 0;
+
+	if (!tcm_hcd || !tcm_hcd->read_message)
+		return 0;
+
+	pr_info("SAaiOS_TOUCH_DBG: drain unread begin attn=%d gpio=%d\n",
+		syna_tcm_attn_active(tcm_hcd) ? 1 : 0,
+		syna_tcm_attn_gpio_value(tcm_hcd));
+
+	for (i = 0; i < 8; i++) {
+		int rc;
+		unsigned char code;
+		unsigned int plen;
+
+		if (i > 0 && !syna_tcm_attn_active(tcm_hcd))
+			break;
+
+		rc = tcm_hcd->read_message(tcm_hcd, NULL, 0);
+		code = tcm_hcd->status_report_code;
+		plen = tcm_hcd->payload_length;
+		n++;
+
+		if (i < 4 || code == REPORT_STATUS)
+			pr_info("SAaiOS_TOUCH_DBG: drain unread i=%d rc=%d code=0x%02x plen=%u attn=%d gpio=%d\n",
+				i, rc, code, plen,
+				syna_tcm_attn_active(tcm_hcd) ? 1 : 0,
+				syna_tcm_attn_gpio_value(tcm_hcd));
+
+		if (code == REPORT_STATUS && plen == 2) {
+			unsigned char b0 = 0, b1 = 0;
+
+			LOCK_BUFFER(tcm_hcd->in);
+			if (tcm_hcd->in.buf &&
+					tcm_hcd->in.buf_size >= MESSAGE_HEADER_SIZE + 2) {
+				b0 = tcm_hcd->in.buf[MESSAGE_HEADER_SIZE];
+				b1 = tcm_hcd->in.buf[MESSAGE_HEADER_SIZE + 1];
+			}
+			UNLOCK_BUFFER(tcm_hcd->in);
+			pr_info("SAaiOS_TOUCH_DBG: REPORT_STATUS leftover payload %02x %02x\n",
+				b0, b1);
+		}
+
+		if (plen > 512) {
+			if (plen == last_large) {
+				stuck++;
+				if (stuck >= 1) {
+					pr_info("SAaiOS_TOUCH_DBG: drain unread stop large plen=%u\n",
+						plen);
+					break;
+				}
+			} else {
+				stuck = 0;
+				last_large = plen;
+			}
+			continue;
+		}
+
+		if ((syna_tcm_status_ok_drained(tcm_hcd) && plen == 0) ||
+				(plen == 0 && !syna_tcm_attn_active(tcm_hcd)))
+			break;
+	}
+
+	tcm_hcd->payload_length = 0;
+	tcm_hcd->payload_fully_drained = false;
+	pr_info("SAaiOS_TOUCH_DBG: drain unread end n=%d attn=%d gpio=%d\n",
+		n, syna_tcm_attn_active(tcm_hcd) ? 1 : 0,
+		syna_tcm_attn_gpio_value(tcm_hcd));
+	return n;
+}
+
+/* Stock after HDL-complete: identify(true) then touch_reinit. Never 0x05. */
+static int syna_tcm_identify_touch_reinit(struct syna_tcm_hcd *tcm_hcd)
+{
+	int retval;
+
+	if (!tcm_hcd)
+		return 0;
+
+	pr_info("SAaiOS_TOUCH_DBG: identify+touch_reinit (no ENABLE_REPORT) mode=0x%02x in_hdl_mode=%d\n",
+		tcm_hcd->id_info.mode, tcm_hcd->in_hdl_mode ? 1 : 0);
+
+	syna_tcm_drain_unread_reports(tcm_hcd);
+
+	retval = tcm_hcd->identify(tcm_hcd, true);
+	if (retval < 0) {
+		if (IS_FW_MODE(tcm_hcd->id_info.mode)) {
+			input_err(true, tcm_hcd->pdev->dev.parent,
+				"identify timed out, continuing with on-chip FW\n");
+		} else {
+			input_err(true, tcm_hcd->pdev->dev.parent,
+				"Application firmware is not running\n");
+			return retval;
+		}
+	}
+
+	retval = touch_reinit(tcm_hcd);
+	if (retval < 0) {
+		input_err(true, tcm_hcd->pdev->dev.parent,
+			"Failed to initialze touch reporting\n");
+		return retval;
+	}
+
+	tcm_hcd->report_touch_cmd_sent = true;
+	pr_info("SAaiOS_TOUCH_DBG: touch_reinit ok init_touch_ok path (no 0x05)\n");
+	return 0;
+}
 
 static int syna_tcm_attn_clear_pending(struct syna_tcm_hcd *tcm_hcd)
