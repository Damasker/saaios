+
 	retval = sec_fn_init(tcm_hcd);
 	if (retval < 0) {
 		input_err(true, tcm_hcd->pdev->dev.parent, "Failed to sec_fn_init\n");
--- a/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_zeroflash.c
