 		input_info(true, tcm_hcd->pdev->dev.parent,
-			"Host-download firmware already running (build id = %d)\n",
+			"Host-download firmware already running (build id = %d), in_hdl_mode cleared\n",
 			tcm_hcd->packrat_number);
 	} else {
 		input_info(true, tcm_hcd->pdev->dev.parent,
@@ -3804,18 +3944,27 @@
 
 	atomic_set(&tcm_hcd->host_downloading, 0);
 
-	syna_tcm_attn_clear_pending(tcm_hcd);
+	syna_tcm_drain_unread_reports(tcm_hcd);
 
-	pr_info("SAaiOS_TOUCH_DBG: probe before touch_init mode=0x%02x app_info_sent=%d\n",
-		tcm_hcd->id_info.mode, tcm_hcd->app_info_cmd_sent ? 1 : 0);
+	pr_info("SAaiOS_TOUCH_DBG: probe before touch_init mode=0x%02x app_info_sent=%d in_hdl_mode=%d\n",
+		tcm_hcd->id_info.mode, tcm_hcd->app_info_cmd_sent ? 1 : 0,
+		tcm_hcd->in_hdl_mode ? 1 : 0);
 
 	/* initialize the touch reporting */
 	retval = touch_init(tcm_hcd);
 	if (retval < 0) {
 		input_err(true, tcm_hcd->pdev->dev.parent, "Failed to initialze touch reporting\n");
 		goto err_tcm_identify;
 	}
 
+	/* Stock HDL-complete helper: identify + touch_reinit, not 0x05. */
+	if (IS_FW_MODE(tcm_hcd->id_info.mode) && !tcm_hcd->in_hdl_mode) {
+		retval = syna_tcm_identify_touch_reinit(tcm_hcd);
