-						pr_info("SAaiOS_TOUCH_DBG: ENABLE_REPORT salvage stuck plen=%u at i=%d, stop\n",
+						pr_info("SAaiOS_TOUCH_DBG: ENABLE_REPORT salvage stuck plen=%u at i=%d, assume ok\n",
