From: SaaiOS <os@saaios>
Subject: synaptics td4150: clear stale plen after continued_read; fix ENABLE_REPORT ack

v019 since9: continued_read drains 13325-byte unsolicited frames and
normalizes status to STATUS_OK, but payload_length stays 13325. ATTN clear
and write_message timeout then log stale plen=13325; salvage requires
plen==0 and never confirms ENABLE_REPORT. IRQ stays dead, event3 empty.

Root cause:
1. TD4150 continued-read chains leave header plen unchanged after rem=0.
2. write_message 1s timeout expires while a 52-chunk drain is in flight.
3. Stale plen from ATTN clear poisons ENABLE_REPORT failure logs/salvage.

Fix:
1. payload_fully_drained flag set when continued_read rem hits zero.
2. syna_tcm_status_ok_drained(): STATUS_OK && (plen==0 || drained).
3. dispatch_response: CMD_ENABLE_REPORT ack with drained transport.
4. ATTN clear + pre-0x05: zero stale payload_length.
5. ENABLE_REPORT write_message timeout 15s (52 chunks).
6. Salvage: accept drained STATUS_OK; on repeated plen assume enable ok.

Applies after syna-tcm-continued-read-complete.patch.

--- a/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.h
+++ b/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.h
@@ -568,6 +568,7 @@ struct syna_tcm_hcd {
 	bool lcdoff_test;
 	bool app_info_cmd_sent;
 	bool report_touch_cmd_sent;
+	bool payload_fully_drained;
 	const struct syna_tcm_hw_interface *hw_if;
 	int (*reset)(struct syna_tcm_hcd *tcm_hcd);
 	int (*reset_n_reinit)(struct syna_tcm_hcd *tcm_hcd, bool hw, bool update_wd);
--- a/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.c
+++ b/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.c
@@ -95,6 +95,16 @@ static int syna_tcm_sensor_detection(struct syna_tcm_hcd *tcm_hcd);
 static void syna_tcm_check_hdl(struct syna_tcm_hcd *tcm_hcd,
 							unsigned char id);
 
+/* TD4150 continued-read chains can finish with STATUS_OK while the header
+ * plen field still shows the original multi-chunk size. Transport is done
+ * once remaining_length hits zero (payload_fully_drained).
+ */
+static bool syna_tcm_status_ok_drained(struct syna_tcm_hcd *tcm_hcd)
+{
+	return tcm_hcd->status_report_code == STATUS_OK &&
+		(tcm_hcd->payload_length == 0 || tcm_hcd->payload_fully_drained);
+}
+
 /* Clock leftover bytes after a failed ROMBOOT 0x45 / identify-as-reset.
  * 0xa0 padding is a shifted frame; ATTN stays asserted until the host
  * reads. Must run with rw_ctrl_mutex held.
@@ -208,6 +218,9 @@ static int syna_tcm_attn_clear_pending(struct syna_tcm_hcd *tcm_hcd)
 
 	pr_info("SAaiOS_TOUCH_DBG: ATTN clear_pending end attn=%d reads=%d\n",
 		syna_tcm_attn_active(tcm_hcd) ? 1 : 0, n);
+	/* Do not leave a drained unsolicited frame's header plen in global state. */
+	tcm_hcd->payload_length = 0;
+	tcm_hcd->payload_fully_drained = false;
 	return n;
 }
 
@@ -497,7 +510,14 @@ static void syna_tcm_dispatch_response(struct syna_tcm_hcd *tcm_hcd)
 
 	tcm_hcd->response_code = tcm_hcd->status_report_code;
 
-	if (tcm_hcd->payload_length == 0) {
+	if (tcm_hcd->payload_length == 0 ||
+			(tcm_hcd->payload_fully_drained &&
+			 tcm_hcd->command == CMD_ENABLE_REPORT &&
+			 tcm_hcd->status_report_code == STATUS_OK)) {
+		if (tcm_hcd->payload_fully_drained &&
+				tcm_hcd->command == CMD_ENABLE_REPORT)
+			tcm_hcd->payload_length = 0;
 		atomic_set(&tcm_hcd->command_status, CMD_IDLE);
 		goto exit;
 	}
@@ -798,9 +818,14 @@ static int syna_tcm_continued_read(struct syna_tcm_hcd *tcm_hcd)
 			tcm_hcd->status_report_code == STATUS_CONTINUED_READ)
