@@ -2394,28 +2419,34 @@ int syna_tcm_enable_touch_report(struct syna_tcm_hcd *tcm_hcd)
 			plen = tcm_hcd->payload_length;
 
 			if (i < 4 || code == STATUS_OK) {
-				pr_info("SAaiOS_TOUCH_DBG: ENABLE_REPORT salvage poll i=%d rc=%d code=0x%02x plen=%u\n",
