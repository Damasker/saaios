 			"Timed out waiting for response (command 0x%02x)\n", tcm_hcd->command);
@@ -2364,6 +2386,8 @@ int syna_tcm_enable_touch_report(struct syna_tcm_hcd *tcm_hcd)
 		tcm_hcd->id_info.mode,
 		tcm_hcd->report_touch_cmd_sent ? 1 : 0);
 	syna_tcm_attn_clear_pending(tcm_hcd);
+	tcm_hcd->payload_length = 0;
+	tcm_hcd->payload_fully_drained = false;
 	syna_tcm_set_scan_start_stop_cmd(tcm_hcd, 1);
 
 	retval = tcm_hcd->write_message(tcm_hcd, CMD_ENABLE_REPORT,
@@ -2378,7 +2402,8 @@ int syna_tcm_enable_touch_report(struct syna_tcm_hcd *tcm_hcd)
 		/* Timeout often means STATUS_OK sat unread (IRQ miss), but the
 		 * bus may also hold a large unsolicited continued-read frame
