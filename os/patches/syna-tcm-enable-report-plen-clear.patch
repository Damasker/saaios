-				pr_info("SAaiOS_TOUCH_DBG: ENABLE_REPORT confirmed STATUS_OK at i=%d\n",
-					i);
+				pr_info("SAaiOS_TOUCH_DBG: ENABLE_REPORT confirmed STATUS_OK at i=%d plen=%u drained=%d\n",
+					i, plen, tcm_hcd->payload_fully_drained ? 1 : 0);
