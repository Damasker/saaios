diff -ruN a/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_zeroflash.c b/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_zeroflash.c
--- a/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_zeroflash.c	2026-08-19 19:19:23.567018318 -0400
+++ b/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_zeroflash.c	2026-08-19 19:21:13.969935896 -0400
@@ -1294,16 +1294,13 @@
 
 	/* Stock 0x45 payload header is 14 reserved bytes:
 	 *   [0]     = image_size >> 16  (high byte of 24-bit TOTAL size)
-	 *   [1..13] = 0
-	 *   [14..]  = firmware (16-aligned with the TCM u16 length bytes)
-	 * No chunk index, no this-chunk size, no HDL type byte (0x30 has
-	 * hdl_version+type; 0x45 does not). data_size_blocks is debug-only.
-	 *
-	 * Stock left [1] and [2] zero because an unchunked SPI write put
-	 * the low 16 bits of (size+14) in the TCM length field. Chunk 0
-	 * is 4080 bytes; BE u16 [0:1]=0x0100 looks like ~4096 and the IC
-	 * IDENTIFYs. Complete the 24-bit BE total here. Never put
-	 * chunk_space in this header or in the TCM length field.
+	 *   [1]     = image_size >> 8
+	 *   [2]     = image_size
+	 *   [3..13] = 0
+	 *   [14..]  = firmware
+	 * Image total lives here, not in the TCM u16 length. write_message
+	 * must put this-chunk xfer in that u16 (never image+14, which
+	 * wraps to 31758). First packet CMD 0x45, later CONTINUE 0x01.
 	 */
 	out_buf[0] = (unsigned char)(image_size >> 16);
 	out_buf[1] = (unsigned char)(image_size >> 8);
