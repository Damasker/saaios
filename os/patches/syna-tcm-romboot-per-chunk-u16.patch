+++ b/drivers/input/touchscreen/synaptics/td4150/synaptics_tcm_core.h	2026-08-19 19:21:26.378262145 -0400
@@ -576,6 +576,7 @@
 	unsigned int romboot_chunks_left;
 	unsigned int romboot_remaining;
