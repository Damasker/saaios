+/* First unblank / decon already on: run 0x45 if probe deferred it.
+ * If 0x45 already went out before panel, retry 0x42 once — not 97k.
+ */
+int zeroflash_on_panel_enabled(struct syna_tcm_hcd *tcm_hcd)
+{
+	int retval;
+
+	if (!tcm_hcd)
+		return -EINVAL;
+
+	syna_tcm_log_panel_env(tcm_hcd, "panel_enabled");
+
+	if (IS_FW_MODE(tcm_hcd->id_info.mode) || tcm_hcd->romboot_download_ok)
+		return 0;
+
+	retval = zeroflash_ensure_hcd(tcm_hcd);
+	if (retval < 0)
+		return retval;
+
+	if (tcm_hcd->romboot_download_deferred && !tcm_hcd->romboot_bytes_sent) {
+		tcm_hcd->romboot_download_deferred = false;
+		pr_info("SAaiOS_TOUCH_DBG: panel up, run deferred 0x45 mode=0x%02x\n",
+			tcm_hcd->id_info.mode);
+		zeroflash_do_romboot_firmware_download();
+		tcm_hcd->romboot_42_after_panel = true;
+		return tcm_hcd->romboot_download_ok ? 0 : -EIO;
+	}
+
+	if (tcm_hcd->romboot_bytes_sent &&
+			tcm_hcd->id_info.mode == MODE_ROMBOOTLOADER &&
+			!tcm_hcd->romboot_42_after_panel) {
+		tcm_hcd->romboot_42_after_panel = true;
+		if (tcm_hcd->romboot_irq_held)
+			syna_tcm_romboot_release_irq(tcm_hcd);
+		pr_info("SAaiOS_TOUCH_DBG: panel up, retry 0x42 once (0x45 already sent)\n");
+		retval = tcm_hcd->switch_mode(tcm_hcd, FW_MODE_BOOTLOADER);
+		pr_info("SAaiOS_TOUCH_DBG: 0x42 after panel retval=%d mode=0x%02x gpio=%d irq_en=%d held=%d\n",
+			retval, tcm_hcd->id_info.mode,
+			zeroflash_attn_gpio_value(tcm_hcd),
+			tcm_hcd->irq_enabled ? 1 : 0,
+			tcm_hcd->romboot_irq_held ? 1 : 0);
+		syna_tcm_wait_identify_after_42(tcm_hcd);
+		if (IS_FW_MODE(tcm_hcd->id_info.mode)) {
+			tcm_hcd->romboot_download_ok = true;
+			pr_info("SAaiOS_TOUCH_DBG: 0x42 after panel firmware started mode=0x%02x\n",
+				tcm_hcd->id_info.mode);
+		} else {
+			pr_info("SAaiOS_TOUCH_DBG: 0x42 after panel still RomBoot mode=0x%02x\n",
+				tcm_hcd->id_info.mode);
+		}
+		return tcm_hcd->romboot_download_ok ? 0 : -ETIME;
+	}
+
+	return 0;
+}
