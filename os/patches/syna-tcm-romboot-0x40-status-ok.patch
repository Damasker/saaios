+	code = tcm_hcd->status_report_code;
+	if (test_and_set_bit(code, romboot_40_seen))
+		return;
+	pr_info("SAaiOS_TOUCH_DBG: 0x40 wait report code=0x%02x mode=0x%02x gpio=%d\n",
+		code, tcm_hcd->id_info.mode, syna_tcm_attn_gpio_value(tcm_hcd));
+}
