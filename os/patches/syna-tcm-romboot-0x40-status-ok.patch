+	unsigned char code;
+
+	if (!tcm_hcd)
+		return;
+	if (!(atomic_read(&tcm_hcd->command_status) == CMD_BUSY &&
+	      tcm_hcd->command == CMD_GET_ROMBOOT_INFO))
+		return;
