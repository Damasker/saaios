-/* Blocking CMD_DOWNLOAD_CONFIG (0x30). Never queue_work. Never fake retval=0. */
+/* Stock HDL v2 0x30 header: buf[0]=hdl_version (2), buf[1]=HDL_TOUCH_CONFIG.
+ * Used only if the firmware APP_CONFIG blob is missing.
+ */
+static int zeroflash_download_hdl_v2_header(void)
+{
+	int retval;
+	unsigned char response_code;
+	struct syna_tcm_hcd *tcm_hcd = zeroflash_hcd->tcm_hcd;
+
+	LOCK_BUFFER(zeroflash_hcd->out);
+
+	retval = syna_tcm_alloc_mem(tcm_hcd, &zeroflash_hcd->out, 2);
+	if (retval < 0) {
+		input_err(true, tcm_hcd->pdev->dev.parent,
+				"Failed to allocate memory for HDL v2 header\n");
+		goto unlock_out;
+	}
+
+	switch (zeroflash_hcd->fw_status.hdl_version) {
+	case 0:
+	case 1:
+		zeroflash_hcd->out.buf[0] = 1;
+		break;
+	case 2:
+		zeroflash_hcd->out.buf[0] = 2;
+		break;
+	default:
+		zeroflash_hcd->out.buf[0] = 2;
+		break;
+	}
+	zeroflash_hcd->out.buf[1] = HDL_TOUCH_CONFIG;
+	zeroflash_hcd->out.data_length = 2;
+
+	pr_info("SAaiOS_TOUCH_DBG: 0x30 payload source=hdl_v2_header_only pkt_len=%u hdr=%02x %02x\n",
+		zeroflash_hcd->out.data_length,
+		zeroflash_hcd->out.buf[0], zeroflash_hcd->out.buf[1]);
+
+	LOCK_BUFFER(zeroflash_hcd->resp);
+
+	retval = tcm_hcd->write_message(tcm_hcd, CMD_DOWNLOAD_CONFIG,
+			zeroflash_hcd->out.buf, zeroflash_hcd->out.data_length,
+			&zeroflash_hcd->resp.buf, &zeroflash_hcd->resp.buf_size,
+			&zeroflash_hcd->resp.data_length, &response_code, 0);
+	zeroflash_log_cmd_download_config(tcm_hcd, response_code, retval);
+	UNLOCK_BUFFER(zeroflash_hcd->resp);
+
+unlock_out:
+	UNLOCK_BUFFER(zeroflash_hcd->out);
+
+	return retval;
+}
+
