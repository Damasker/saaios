+int syna_tcm_pulse_tsp_reset(struct syna_tcm_hcd *tcm_hcd)
+{
+	const struct syna_tcm_board_data *bdata;
+	int reset_gpio = -1;
+	int active_ms = 10;
+	int delay_ms = 50;
+
+	if (!tcm_hcd || !tcm_hcd->hw_if || !tcm_hcd->hw_if->bdata)
+		return -EINVAL;
+
+	bdata = tcm_hcd->hw_if->bdata;
+	reset_gpio = bdata->reset_gpio;
+	if (bdata->reset_active_ms)
+		active_ms = bdata->reset_active_ms;
+	if (bdata->reset_delay_ms)
+		delay_ms = bdata->reset_delay_ms;
+
+	pr_info("SAaiOS_TOUCH_DBG: since23 path=A TSP reset reset_gpio=%d lcd_rst=%s irq_en=%d gpio=%d\n",
+		reset_gpio,
+		bdata->regulator_lcd_reset ? bdata->regulator_lcd_reset : "none",
+		tcm_hcd->irq_enabled ? 1 : 0,
+		syna_tcm_attn_gpio_value(tcm_hcd));
+
+	if (reset_gpio >= 0) {
+		gpio_set_value(reset_gpio, bdata->reset_on_state);
+		msleep(active_ms);
+		gpio_set_value(reset_gpio, !bdata->reset_on_state);
+		msleep(delay_ms);
+		return 0;
+	}
+
+	/* spi1.2 DT has no synaptics,reset-gpio; TSP shares gpio_lcd_rst. */
+	if (!IS_ERR_OR_NULL(tcm_hcd->regulator_lcd_reset)) {
+		regulator_force_disable(tcm_hcd->regulator_lcd_reset);
+		msleep(active_ms);
+		regulator_enable(tcm_hcd->regulator_lcd_reset);
+		msleep(delay_ms);
+		return 0;
+	}
+
+	pr_info("SAaiOS_TOUCH_DBG: since23 path=A no TSP reset GPIO in DT\n");
+	return -ENODEV;
+}
