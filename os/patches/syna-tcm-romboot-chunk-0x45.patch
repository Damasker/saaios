+int zeroflash_retry_romboot_hdl(struct syna_tcm_hcd *tcm_hcd)
+{
+	int retval;
+
+	if (!tcm_hcd)
+		return -EINVAL;
+
+	retval = zeroflash_ensure_hcd(tcm_hcd);
+	if (retval < 0)
+		return retval;
+
+	if (tcm_hcd->romboot_download_ok)
+		return 0;
+
+	if (zeroflash_hcd->romboot_retry_used) {
+		pr_info("SAaiOS_TOUCH_DBG: since23 path=A 0x45 retry already used mode=0x%02x\n",
+			tcm_hcd->id_info.mode);
+		return -EIO;
+	}
+	zeroflash_hcd->romboot_retry_used = true;
+
+	if (current->pid == tcm_hcd->isr_pid) {
+		pr_info("SAaiOS_TOUCH_DBG: since23 path=A 0x45 retry deferred (not ISR-safe)\n");
+		return 0;
+	}
+
+	pr_info("SAaiOS_TOUCH_DBG: since23 path=A pulse reset then retry chunked 0x45 mode=0x%02x\n",
+		tcm_hcd->id_info.mode);
+
+	retval = syna_tcm_pulse_tsp_reset(tcm_hcd);
+	if (retval < 0)
+		pr_info("SAaiOS_TOUCH_DBG: since23 path=A TSP reset unavailable retval=%d, try 0x45 anyway\n",
+			retval);
+
+	if (zeroflash_attn_active(tcm_hcd) && tcm_hcd->read_message)
+		tcm_hcd->read_message(tcm_hcd, NULL, 0);
+
+	pr_info("SAaiOS_TOUCH_DBG: since23 path=A after reset mode=0x%02x attn=%d gpio=%d irq_en=%d\n",
+		tcm_hcd->id_info.mode,
+		zeroflash_attn_active(tcm_hcd) ? 1 : 0,
+		zeroflash_attn_gpio_value(tcm_hcd),
+		tcm_hcd->irq_enabled ? 1 : 0);
+
+	if (tcm_hcd->id_info.mode != MODE_ROMBOOTLOADER &&
+			!zeroflash_attn_active(tcm_hcd)) {
+		pr_info("SAaiOS_TOUCH_DBG: since23 path=A not RomBoot after reset, skip blind 0x45\n");
+		return -EIO;
+	}
+
+	tcm_hcd->in_hdl_mode = true;
+	tcm_hcd->sensor_type = TYPE_ROMBOOT;
+	zeroflash_do_romboot_firmware_download();
+
+	return tcm_hcd->romboot_download_ok ? 0 : -EIO;
+}
