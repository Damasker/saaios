+/* Stock probe after 0x45+0x42 still in RomBoot: identify(false) ->
+ * CMD_GET_ROMBOOT_INFO 0x40. One query, log payload. Not a 0x40 dance.
+ */
+static void zeroflash_log_romboot_info_once(struct syna_tcm_hcd *tcm_hcd)
+{
+	int retval;
+	unsigned int i, n, dump;
+	unsigned char *resp_buf = NULL;
+	unsigned int resp_buf_size = 0;
+	unsigned int resp_length = 0;
+	char hex[48];
+
+	if (!tcm_hcd || !tcm_hcd->write_message)
+		return;
+
+	pr_info("SAaiOS_TOUCH_DBG: 0x40 GET_ROMBOOT_INFO after 0x45 gpio=%d irq_en=%d (stock identify in RomBoot)\n",
+		zeroflash_attn_gpio_value(tcm_hcd),
+		tcm_hcd->irq_enabled ? 1 : 0);
+
+	retval = tcm_hcd->write_message(tcm_hcd, CMD_GET_ROMBOOT_INFO,
+			NULL, 0, &resp_buf, &resp_buf_size, &resp_length, NULL, 0);
+
+	hex[0] = '\0';
+	n = 0;
+	dump = resp_length > 12 ? 12 : resp_length;
+	for (i = 0; i < dump && resp_buf; i++)
+		n += scnprintf(hex + n, sizeof(hex) - n, "%s%02x",
+			i ? " " : "", resp_buf[i]);
+	if (!n)
+		scnprintf(hex, sizeof(hex), "-");
+
+	pr_info("SAaiOS_TOUCH_DBG: 0x40 retval=%d plen=%u payload=%s mode=0x%02x gpio=%d\n",
+		retval, resp_length, hex, tcm_hcd->id_info.mode,
+		zeroflash_attn_gpio_value(tcm_hcd));
+
+	if (retval >= 0 && resp_buf && resp_length >= 8)
+		pr_info("SAaiOS_TOUCH_DBG: 0x40 version=%u status=0x%02x asic=%02x%02x wr_block_words=%u max_payload=%u last_reset=0x%02x\n",
+			resp_buf[0], resp_buf[1],
+			resp_buf[2], resp_buf[3],
+			resp_buf[4],
+			resp_buf[5] | (resp_buf[6] << 8),
+			resp_buf[7]);
+
+	kfree(resp_buf);
+}
+
+static void zeroflash_log_1b_bits_after_45(struct syna_tcm_hcd *tcm_hcd)
+{
+	unsigned char raw[2] = {0, 0};
+	struct firmware_status st;
+
+	if (!zeroflash_hcd)
+		return;
+
+	memcpy(&st, &zeroflash_hcd->fw_status, sizeof(st));
+	{
+		unsigned char *fs = (unsigned char *)&zeroflash_hcd->fw_status;
+
+		raw[0] = fs[0];
+		raw[1] = fs[1];
+	}
+
+	if (tcm_hcd && tcm_hcd->status_report_code == REPORT_STATUS) {
+		LOCK_BUFFER(tcm_hcd->in);
+		if (tcm_hcd->in.buf &&
+				tcm_hcd->in.buf_size >= MESSAGE_HEADER_SIZE + 2) {
+			raw[0] = tcm_hcd->in.buf[MESSAGE_HEADER_SIZE];
+			raw[1] = tcm_hcd->in.buf[MESSAGE_HEADER_SIZE + 1];
+			memcpy(&st, raw, sizeof(raw));
+		}
+		UNLOCK_BUFFER(tcm_hcd->in);
+	}
+
+	pr_info("SAaiOS_TOUCH_DBG: 0x45 after 0x1b bits %02x %02x invalid_static=%u need_disp=%u need_app=%u hdlv=%u need_osh=%u reserved=%u\n",
+		raw[0], raw[1],
+		st.invalid_static_config, st.need_disp_config,
+		st.need_app_config, st.hdl_version,
+		st.need_open_short_config, st.reserved);
+}
