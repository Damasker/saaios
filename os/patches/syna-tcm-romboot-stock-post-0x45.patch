+/* after remaining=0: drain until ATTN idle (gpio=1) or 8 frames.
+ * Log each frame once. Parse 0x1b firmware_status. Do not send a TCM
+ * command while gpio=0.
+ */
+int syna_tcm_romboot_drain_after_send(struct syna_tcm_hcd *tcm_hcd)
+{
+	int i, n = 0;
+	char payload[32];
+
+	if (!tcm_hcd || !tcm_hcd->read_message)
+		return 0;
+
+	syna_tcm_romboot_hold_irq(tcm_hcd);
+
+	for (i = 0; i < 8; i++) {
+		unsigned char code;
+		unsigned int plen;
+		unsigned int j, pn, dump;
+		unsigned char raw[2] = {0, 0};
+
+		if (!syna_tcm_attn_active(tcm_hcd))
+			break;
+
+		tcm_hcd->read_message(tcm_hcd, NULL, 0);
+		code = tcm_hcd->status_report_code;
+		plen = tcm_hcd->payload_length;
+		n++;
+
+		payload[0] = '\0';
+		pn = 0;
+		dump = plen > 8 ? 8 : plen;
+		LOCK_BUFFER(tcm_hcd->in);
+		for (j = 0; j < dump && tcm_hcd->in.buf &&
+				tcm_hcd->in.buf_size >= MESSAGE_HEADER_SIZE + j + 1;
+				j++) {
+			pn += scnprintf(payload + pn, sizeof(payload) - pn,
+				"%s%02x", j ? " " : "",
+				tcm_hcd->in.buf[MESSAGE_HEADER_SIZE + j]);
+		}
+		if (code == REPORT_STATUS && tcm_hcd->in.buf &&
+				tcm_hcd->in.buf_size >= MESSAGE_HEADER_SIZE + 2) {
+			raw[0] = tcm_hcd->in.buf[MESSAGE_HEADER_SIZE];
+			raw[1] = tcm_hcd->in.buf[MESSAGE_HEADER_SIZE + 1];
+		}
+		UNLOCK_BUFFER(tcm_hcd->in);
+		if (!pn)
+			scnprintf(payload, sizeof(payload), "-");
+
+		pr_info("SAaiOS_TOUCH_DBG: 0x45 after send drain n=%d code=0x%02x plen=%u payload=%s mode=0x%02x gpio=%d\n",
+			n, code, plen, payload, tcm_hcd->id_info.mode,
+			syna_tcm_attn_gpio_value(tcm_hcd));
+
+		if (code == REPORT_STATUS) {
+			struct {
+				unsigned short invalid_static_config:1;
+				unsigned short need_disp_config:1;
+				unsigned short need_app_config:1;
+				unsigned short hdl_version:4;
+				unsigned short need_open_short_config:1;
+				unsigned short reserved:8;
+			} __packed st;
+
+			memcpy(&st, raw, sizeof(raw));
+			pr_info("SAaiOS_TOUCH_DBG: REPORT_STATUS fw_status %02x %02x invalid_static=%u need_disp=%u need_app=%u hdlv=%u need_osh=%u reserved=%u\n",
+				raw[0], raw[1],
+				st.invalid_static_config, st.need_disp_config,
+				st.need_app_config, st.hdl_version,
+				st.need_open_short_config, st.reserved);
+		}
+
+		if (code == REPORT_IDENTIFY ||
+				IS_FW_MODE(tcm_hcd->id_info.mode))
+			pr_info("SAaiOS_TOUCH_DBG: 0x45 firmware started mode=0x%02x\n",
+				tcm_hcd->id_info.mode);
+	}
+
+	if (n == 0 && !syna_tcm_attn_active(tcm_hcd))
+		pr_info("SAaiOS_TOUCH_DBG: 0x45 sent no ATTN gpio=%d\n",
+			syna_tcm_attn_gpio_value(tcm_hcd));
+	else if (syna_tcm_attn_active(tcm_hcd))
+		pr_info("SAaiOS_TOUCH_DBG: 0x45 gpio never idle after %d frames mode=0x%02x gpio=%d\n",
+			n, tcm_hcd->id_info.mode,
+			syna_tcm_attn_gpio_value(tcm_hcd));
+	else if (tcm_hcd->id_info.mode == MODE_ROMBOOTLOADER)
+		pr_info("SAaiOS_TOUCH_DBG: 0x45 still RomBoot after drain mode=0x%02x gpio=%d\n",
+			tcm_hcd->id_info.mode,
+			syna_tcm_attn_gpio_value(tcm_hcd));
+
+	/* Leave IRQ held if ATTN is still asserted so ISR cannot steal
+	 * leftover frames before the stock post-download command.
+	 */
+	if (!syna_tcm_attn_active(tcm_hcd))
+		syna_tcm_romboot_release_irq(tcm_hcd);
+
+	return n;
+}
