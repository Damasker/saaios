+/* since26: mask IRQ so process context owns SPI. Threaded ISR must use
+ * nosync (disable_irq waits for the running handler and would deadlock).
+ * irq_enabled stays true — IRQ remains registered. Never restore do_polling.
+ */
+void syna_tcm_romboot_hold_irq(struct syna_tcm_hcd *tcm_hcd)
+{
+	if (!tcm_hcd || tcm_hcd->romboot_irq_held)
+		return;
+	if (!tcm_hcd->irq_enabled || tcm_hcd->irq < 0)
+		return;
+	tcm_hcd->romboot_irq_held = true;
+	if (current->pid == tcm_hcd->isr_pid)
+		disable_irq_nosync(tcm_hcd->irq);
+	else
+		disable_irq(tcm_hcd->irq);
+}
+
+void syna_tcm_romboot_release_irq(struct syna_tcm_hcd *tcm_hcd)
+{
+	if (!tcm_hcd || !tcm_hcd->romboot_irq_held)
+		return;
+	tcm_hcd->romboot_irq_held = false;
+	if (tcm_hcd->irq_enabled && tcm_hcd->irq >= 0)
+		enable_irq(tcm_hcd->irq);
+}
+
+/* since26: first 0x45 (not only retry). Hold IRQ, force one header+payload
+ * read (continued_read inside read_message), log once. 0x1b re-asserts —
+ * do not skip 0x45 if gpio still 0. Stock romboot download must proceed.
+ */
+int syna_tcm_romboot_drain_attn(struct syna_tcm_hcd *tcm_hcd)
+{
+	int n = 0;
+	unsigned char code = 0;
+	unsigned int plen = 0;
+	unsigned char saved_task;
+	static bool logged;
+	bool blocked_helper = false;
+
+	if (!tcm_hcd)
+		return 0;
+
+	syna_tcm_romboot_hold_irq(tcm_hcd);
+
+	saved_task = atomic_read(&tcm_hcd->helper.task);
+	if (saved_task == HELP_NONE) {
+		atomic_set(&tcm_hcd->helper.task, HELP_SEND_ROMBOOT_HDL);
+		blocked_helper = true;
+	}
+
+	if (tcm_hcd->read_message && syna_tcm_attn_active(tcm_hcd)) {
+		tcm_hcd->read_message(tcm_hcd, NULL, 0);
+		code = tcm_hcd->status_report_code;
+		plen = tcm_hcd->payload_length;
+		n = 1;
+		if (code != REPORT_STATUS && syna_tcm_attn_active(tcm_hcd))
+			n += syna_tcm_drain_unread_reports_quiet(tcm_hcd);
+	}
+
+	if (n == 0 && syna_tcm_attn_active(tcm_hcd) && tcm_hcd->read_message) {
+		tcm_hcd->read_message(tcm_hcd, NULL, 0);
+		code = tcm_hcd->status_report_code;
+		plen = tcm_hcd->payload_length;
+		n = 1;
+	}
+
+	if (blocked_helper)
+		atomic_set(&tcm_hcd->helper.task, HELP_NONE);
+
+	if (!logged) {
+		logged = true;
+		pr_info("SAaiOS_TOUCH_DBG: 0x45 first drain n=%d code=0x%02x plen=%u gpio=%d\n",
+			n, code, plen, syna_tcm_attn_gpio_value(tcm_hcd));
+	}
+
+	return n;
+}
