+int zeroflash_handle_report_status(struct syna_tcm_hcd *tcm_hcd, bool wait)
+{
+	int retval;
+	unsigned char raw[2] = {0, 0};
+	unsigned char *src = NULL;
+	unsigned int src_size = 0;
+	struct firmware_status *st;
+	bool need_cfg;
