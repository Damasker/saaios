+				retval, tcm_hcd->id_info.mode);
+			return retval;
+		}
+		if (created)
+			pr_info("SAaiOS_TOUCH_DBG: zeroflash config-only init (no ROMBOOT 0x45)\n");
+	}
+
+	if (zeroflash_hcd->config_attempted) {
+		pr_info("SAaiOS_TOUCH_DBG: zeroflash_download_config ran=0 already attempted retval=%d mode=0x%02x\n",
+			zeroflash_hcd->last_config_retval, tcm_hcd->id_info.mode);
+		if (wait && zeroflash_hcd->workqueue &&
+				current->pid != tcm_hcd->isr_pid)
+			flush_workqueue(zeroflash_hcd->workqueue);
+		return 0;
+	}
+
+	if (tcm_hcd->report.buffer.buf && tcm_hcd->report.buffer.buf_size >= 2) {
+		src = tcm_hcd->report.buffer.buf;
+		src_size = tcm_hcd->report.buffer.buf_size;
+		retval = secure_memcpy((unsigned char *)&zeroflash_hcd->fw_status,
+				sizeof(zeroflash_hcd->fw_status),
+				src, src_size,
+				sizeof(zeroflash_hcd->fw_status));
+	} else {
+		LOCK_BUFFER(tcm_hcd->in);
+		if (tcm_hcd->in.buf &&
+				tcm_hcd->in.buf_size >= MESSAGE_HEADER_SIZE + 2) {
+			src = &tcm_hcd->in.buf[MESSAGE_HEADER_SIZE];
+			src_size = tcm_hcd->in.buf_size - MESSAGE_HEADER_SIZE;
+			retval = secure_memcpy((unsigned char *)&zeroflash_hcd->fw_status,
+					sizeof(zeroflash_hcd->fw_status),
+					src, src_size,
+					sizeof(zeroflash_hcd->fw_status));
+		} else {
+			retval = -EINVAL;
+		}
+		UNLOCK_BUFFER(tcm_hcd->in);
+	}
+
+	if (retval < 0 || !src) {
+		pr_info("SAaiOS_TOUCH_DBG: REPORT_STATUS fw_status missing payload mode=0x%02x\n",
+			tcm_hcd->id_info.mode);
+		if (retval < 0)
+			input_err(true, tcm_hcd->pdev->dev.parent,
+					"Failed to copy firmware status\n");
+		pr_info("SAaiOS_TOUCH_DBG: zeroflash_download_config ran=0 retval=%d mode=0x%02x\n",
+			retval < 0 ? retval : -EINVAL, tcm_hcd->id_info.mode);
+		return retval < 0 ? retval : -EINVAL;
+	}
+
+	{
+		unsigned char *fs = (unsigned char *)&zeroflash_hcd->fw_status;
+
+		raw[0] = fs[0];
+		raw[1] = fs[1];
+	}
+	st = &zeroflash_hcd->fw_status;
+	pr_info("SAaiOS_TOUCH_DBG: REPORT_STATUS fw_status %02x %02x inv=%u disp=%u app=%u hdlv=%u osh=%u\n",
+		raw[0], raw[1],
+		st->invalid_static_config, st->need_disp_config,
+		st->need_app_config, st->hdl_version,
+		st->need_open_short_config);
+
+	need_cfg = st->need_app_config || st->need_disp_config
+			|| (st->need_open_short_config
+			&& zeroflash_hcd->has_open_short_config);
+
+	/*
+	 * 10 00 = HDL v2, need_* bits clear. On-chip 0x02 after skipped 0x45
+	 * still needs APP_CONFIG via CMD_DOWNLOAD_CONFIG (0x30), not ROMBOOT.
+	 * Do not set in_hdl_mode; do not retry 0x45.
+	 */
+	if (!need_cfg && IS_FW_MODE(tcm_hcd->id_info.mode) && st->hdl_version
+			&& !zeroflash_hcd->config_attempted) {
+		st->need_app_config = 1;
+		need_cfg = 1;
+		pr_info("SAaiOS_TOUCH_DBG: on-chip 0x1b hdlv=%u force need_app_config\n",
+			st->hdl_version);
+	}
+
+	/* Keep in_hdl_mode as-is (since18 cleared it). Never set it here. */
+	mode_before = tcm_hcd->id_info.mode;
+	zeroflash_hcd->config_attempted = true;
+	zeroflash_hcd->last_config_retval = 0;
+	ran = 1;
+	zeroflash_download_config();
+
+	if (wait && need_cfg && zeroflash_hcd->workqueue &&
+			current->pid != tcm_hcd->isr_pid)
+		flush_workqueue(zeroflash_hcd->workqueue);
+
+	pr_info("SAaiOS_TOUCH_DBG: zeroflash_download_config ran=%d need_cfg=%d wait=%d retval=%d mode=0x%02x->0x%02x in_hdl_mode=%d\n",
+		ran, need_cfg ? 1 : 0, wait ? 1 : 0,
+		zeroflash_hcd->last_config_retval,
+		mode_before, tcm_hcd->id_info.mode,
+		tcm_hcd->in_hdl_mode ? 1 : 0);
+
+	return zeroflash_hcd->last_config_retval;
+}
