+/* IRQ-safe leftover drain after idle 0x1b. Same idle-bus stop as
+ * syna_tcm_drain_unread_reports (stop when attn=0 gpio=1). Cap 8.
+ * No printk per iteration. Never restore do_polling. Re-entrant
+ * read_message is OK: mutex was released by the ISR's first read.
+ */
+static int syna_tcm_drain_unread_reports_quiet(struct syna_tcm_hcd *tcm_hcd)
+{
+	int i, n = 0;
+	static bool in_quiet_drain;
+
+	if (!tcm_hcd || !tcm_hcd->read_message || in_quiet_drain)
+		return 0;
+
+	in_quiet_drain = true;
+	for (i = 0; i < 8; i++) {
+		if (!syna_tcm_attn_active(tcm_hcd))
+			break;
+		tcm_hcd->read_message(tcm_hcd, NULL, 0);
+		n++;
+	}
+	in_quiet_drain = false;
+	return n;
+}
