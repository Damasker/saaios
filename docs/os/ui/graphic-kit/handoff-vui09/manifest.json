      ]
    ],
    "Intent": [
      [
        "goal",
        "IRAB intent",
        "missing → «Нет задачи»"
      ],
      [
        "steps",
        "WSV2 task DAG / plan projection",
        "missing → no step list"
      ],
      [
        "confirm",
        "AskUser pending action only",
        "missing → no confirm"
      ]
    ],
    "NOW": [
      [
        "attention",
        "event/decision projection",
        "0 → «Ничего не требует внимания»"
      ],
      [
        "current work",
        "live task execution",
        "0 → «Нет текущих задач»"
      ],
      [
        "composer",
        "text input + search; mic unavailable",
        "voice disabled"
      ]
    ],
    "Space": [
      [
        "focus task",
        "SOM space membership + task focus",
        "missing → hide focus"
      ],
      [
        "related objects",
        "SOM in-space",
        "0 → «Нет объектов»"
      ],
      [
        "map",
        "no source",
        "omit"
      ]
    ],
    "System": [
      [
        "device / wifi / brightness",
        "DeviceState / settings",
        "missing → unavailable with cause"
      ],
      [
        "Android VM / notebook",
        "runtime capability",
        "Unavailable until runtime exists"
      ]
    ]
  },
