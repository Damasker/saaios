sui 2
screen now {
  component ContextHeader {
    text = Title
    a11y = Heading
    loc = now.header
    focus = 0
    inset = safe
  }
  component ObjectSummary {
    text = Body
    color = TextPrimary
    a11y = Status
    loc = "now.object"
  }
  component SurfacePattern {
    text = Body
    color = TextSecondary
    a11y = Status
    loc = now.empty
  }
  component BottomNavigation {
    a11y = Button
    focus = 1
    scroll = none
    inset = safe
    tab now { loc = now }
    tab spaces { loc = spaces }
    tab search { loc = search }
    tab me { loc = me }
  }
  row apps { loc = now.apps }
  row intent { loc = now.intent }
}
