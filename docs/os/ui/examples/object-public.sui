  component ObjectSummary {
    text = Body
    color = TextPrimary
    a11y = Status
    loc = object.summary
  }
  component DataRow {
    text = Body
    a11y = Status
    loc = object.related
  }
  component SurfacePattern {
    text = Body
    color = TextSecondary
    a11y = Status
    loc = object.permission
  }
}
